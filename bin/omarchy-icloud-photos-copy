#!/bin/bash
# Put an image on the clipboard in a form other apps can paste.
#
# A photo goes as JPEG: the source is a lossy photo to begin with, and the
# same picture as PNG is several times the size for not one pixel more of
# quality. PNG is kept for what needs it, so a screenshot stays sharp and
# anything with transparency keeps it.
#
# Either way the file is re-encoded rather than handed over as it is: the
# previews carry the camera's EXIF, GPS included, and that should not travel
# to whatever the picture is pasted into.
set -euo pipefail
umask 077

if (( $# != 1 )); then
  echo "usage: omarchy-icloud-photos-copy IMAGE" >&2
  exit 1
fi

# Only the first frame of a GIF, and the format decided from the file itself
# rather than its name.
case "$(magick identify -format '%m' "$1[0]" 2>/dev/null)" in
  PNG|GIF|WEBP) type=image/png; out=png; opts=(-define png:compression-level=1) ;;
  *)            type=image/jpeg; out=jpg; opts=(-quality 92 -sampling-factor 4:2:0) ;;
esac

# Finish the conversion before claiming the clipboard: a failed decode should
# leave whatever was there intact.
image=$(mktemp --suffix=".$out")
trap 'rm -f "$image"' EXIT
magick "$1[0]" -auto-orient -strip "${opts[@]}" "$out:$image"
wl-copy --type "$type" < "$image"
